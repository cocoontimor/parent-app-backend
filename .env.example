# Copy to .env and fill in. Do not commit the real .env (it is gitignored).

# --- Core Django ---
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=https://app.example.org   # used to build WhatsApp magic-login links

# --- Database (PostgreSQL) ---
POSTGRES_DATABASE_NAME=cocoon_db
POSTGRES_DATABASE_USER=postgres
POSTGRES_DATABASE_PASSWORD=
POSTGRES_DATABASE_HOST=127.0.0.1
POSTGRES_DATABASE_PORT=5432
POSTGRES_DATABASE_SSLMODE=prefer

# --- Redis / Celery ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# REQUIRED in production: with DEBUG=false, inbound webhooks are rejected
# unless this is set (Meta App Dashboard -> App Settings -> Basic -> App Secret).
WHATSAPP_APP_SECRET=

# --- Google Cloud Storage (media uploads; falls back to local disk if unset) ---
GS_BUCKET_NAME=
GS_PROJECT_ID=
GS_LOCATION=
